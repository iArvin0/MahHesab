# MahHesab | ماه‌حساب
# Copy this file to .env and fill in the token. Keep .env local.
# این فایل را با نام .env کپی کن و توکن واقعی را فقط در همان فایل بنویس.

# Required | ضروری
# In @BotFather, use /newbot or open an existing bot to get its token.
# توکن بات را از @BotFather بگیر. برای بات جدید دستور /newbot را بزن.
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN

# Optional | اختیاری
# Local Python only. Leave commented to use mahhesab.sqlite3 in the working directory.
# برای اجرای محلی پایتون است. برای استفاده از مسیر پیش‌فرض، این خط را کامنت بگذار.
# Docker Compose stores its database in the ledger volume at /data/mahhesab.sqlite3.
# MAHHESAB_DB=./mahhesab.sqlite3

# Optional | اختیاری
# Leave blank for public access, or list permitted Telegram user IDs separated by commas.
# برای استفادهٔ عمومی خالی بگذار. برای بات خصوصی، شناسه‌های عددی تلگرام را با کاما جدا کن.
MAHHESAB_ALLOWED_USER_IDS=
